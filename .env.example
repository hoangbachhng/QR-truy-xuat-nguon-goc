# ==== Sao chép file này thành .env.local (chạy máy) hoặc khai báo trên Vercel/Netlify/server ====

# Tên miền công khai. MÃ QR SẼ CHỨA ĐỊA CHỈ NÀY -> nên dùng tên miền cố định, ví dụ https://mohinh.vinaseed.com.vn
PUBLIC_BASE_URL=http://localhost:3000

# Cơ sở dữ liệu PostgreSQL. Để trống -> dùng PostgreSQL nhúng (PGlite) lưu tại ./data/pglite (chỉ dùng chạy thử trên máy)
# Ví dụ Neon: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Chỉ dùng với docker-compose (server Vinaseed): mật khẩu PostgreSQL đi kèm
POSTGRES_PASSWORD=

# Lưu ảnh/file: local (ổ đĩa server, thư mục ./data/uploads) hoặc s3 (Cloudflare R2, AWS S3, MinIO...)
# Vercel/Netlify KHÔNG lưu file lâu dài -> bắt buộc dùng s3 khi deploy lên 2 nền tảng này
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Khóa ký phiên đăng nhập: BẮT BUỘC, chuỗi ngẫu nhiên tự tạo, dài >= 32 ký tự. Không dùng lại giữa các nơi chạy.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Tài khoản quản trị đầu tiên (tự tạo khi CSDL chưa có người dùng nào). Tự đặt mật khẩu mạnh, không để trống.
ADMIN_EMAIL=admin@vinaseed.local
ADMIN_PASSWORD=

# Mật khẩu chung cho các tài khoản mẫu do `npm run seed` tạo (chỉ dùng chạy thử). Tự đặt, không để trống.
SEED_PASSWORD=
